source(output(
		PID as long,
		{Bsmt Qual} as string,
		{Bsmt Cond} as string,
		{Bsmt Exposure} as string,
		{BsmtFin Type 1} as string,
		{BsmtFin SF 1} as short,
		{BsmtFin Type 2} as string,
		{BsmtFin SF 2} as short,
		{Bsmt Unf SF} as short,
		{Total Bsmt SF} as short,
		{Bsmt Full Bath} as short,
		{Bsmt Half Bath} as short
	),
	allowSchemaDrift: true,
	validateSchema: false,
	ignoreNoFilesFound: false) ~> Bsmt
source(output(
		PID as long,
		{Misc Feature} as string,
		{Misc Val} as short
	),
	allowSchemaDrift: true,
	validateSchema: false,
	ignoreNoFilesFound: false) ~> Misc
source(output(
		Order as short,
		PID as long,
		{Garage Type} as string,
		{Garage Yr Blt} as short,
		{Garage Finish} as string,
		{Garage Cars} as short,
		{Garage Area} as short,
		{Garage Qual} as string,
		{Garage Cond} as string
	),
	allowSchemaDrift: true,
	validateSchema: false,
	ignoreNoFilesFound: false) ~> Garage
source(output(
		PID as long,
		{Pool Area} as short,
		{Pool QC} as string
	),
	allowSchemaDrift: true,
	validateSchema: false,
	ignoreNoFilesFound: false) ~> Pool
source(output(
		{Exter Cond} as long,
		{Exter Qual} as long,
		{Heating QC} as long,
		{Kitchen Qual} as long,
		{MS Zoning} as long,
		pid as long,
		{Roof Style} as string,
		{Roof Matl} as string,
		{Exterior 1st} as string,
		{Exterior 2nd} as string,
		{Mas Vnr Type} as string,
		{Mas Vnr Area} as long,
		foundation as string,
		heating as string,
		{Central Air} as boolean,
		electrical as string,
		{1st Flr SF} as long,
		{2nd Flr SF} as long,
		{Low Qual Fin SF} as long,
		{Kitchen AbvGr} as long,
		{TotRms AbvGrd} as long,
		functional as string,
		fireplaces as long,
		{Fireplace Qu} as string,
		{Paved Drive} as string,
		{Wood Deck SF} as long,
		{Open Porch SF} as long,
		{Enclosed Porch} as long,
		{3Ssn Porch} as long,
		{Screen Porch} as long,
		fence as string,
		{MS SubClass} as long
	),
	allowSchemaDrift: true,
	validateSchema: false,
	isolationLevel: 'READ_UNCOMMITTED',
	format: 'table') ~> Ames
source(output(
		pid as long,
		Floor as long,
		bedrooms as long,
		{Full Bath} as long,
		{Half Bath} as long
	),
	allowSchemaDrift: true,
	validateSchema: false,
	isolationLevel: 'READ_UNCOMMITTED',
	format: 'table') ~> FloorDetail
source(output(
		description as string,
		code as long
	),
	allowSchemaDrift: true,
	validateSchema: false,
	isolationLevel: 'READ_UNCOMMITTED',
	format: 'table') ~> MSSubClass
source(output(
		id as long,
		description as string,
		code as string
	),
	allowSchemaDrift: true,
	validateSchema: false,
	isolationLevel: 'READ_UNCOMMITTED',
	format: 'table') ~> MSZoning
source(output(
		pid as long,
		{Sale Date} as timestamp,
		{Sale Type} as string,
		{Sale Condition} as string,
		saleprice as long
	),
	allowSchemaDrift: true,
	validateSchema: false,
	isolationLevel: 'READ_UNCOMMITTED',
	format: 'table') ~> SaleProperties
source(output(
		id as long,
		code as string,
		description as string
	),
	allowSchemaDrift: true,
	validateSchema: false,
	isolationLevel: 'READ_UNCOMMITTED',
	format: 'table') ~> TypeQuality
source(output(
		PID as long,
		{Lot Frontage} as string,
		{Lot Area} as string,
		Street as string,
		Alley as string,
		{Lot Shape} as string,
		{Land Contour} as string,
		Utilities as string,
		{Lot Config} as string,
		{Land Slope} as string,
		Neighborhood as string,
		{Condition 1} as string,
		{Condition 2} as string,
		{Bldg Type} as string,
		{House Style} as string,
		{Overall Qual} as string,
		{Overall Cond} as string,
		{Year Built} as string,
		{Year Remod/Add} as string
	),
	allowSchemaDrift: true,
	validateSchema: false,
	ignoreNoFilesFound: false) ~> AmesProperty
Ames derive(PID = toLong(trim(toString(pid)))) ~> derivedColumnAmes
SaleProperties derive(PID = toLong(trim(toString(pid)))) ~> derivedColumnSaleProperties
FloorDetail derive(PID = toLong(trim(toString(pid)))) ~> derivedColumnFloorDetail
derivedColumnFloorDetail aggregate(groupBy(derivedColumnFloorDetail@PID),
	FullBath = sum(coalesce(toInteger({Full Bath}), 0)),
		HalfBath = sum(coalesce(toInteger({Half Bath}), 0)),
		Bedroom = sum(coalesce(toInteger(bedrooms), 0))) ~> aggregateFloorDetail
join1, derivedColumnSaleProperties join(derivedColumnAmes@PID == derivedColumnSaleProperties@PID,
	joinType:'left',
	matchType:'exact',
	ignoreSpaces: false,
	broadcast: 'auto')~> joinAmesSalesProperties
joinAmesSalesProperties, aggregateFloorDetail join(derivedColumnAmes@PID == aggregateFloorDetail@PID,
	joinType:'left',
	matchType:'exact',
	ignoreSpaces: false,
	broadcast: 'auto')~> joinFloorDetail
joinFloorDetail, Bsmt join(derivedColumnAmes@PID == Bsmt@PID,
	joinType:'left',
	matchType:'exact',
	ignoreSpaces: false,
	broadcast: 'auto')~> joinBsmt
joinBsmt, Misc join(derivedColumnAmes@PID == Misc@PID,
	joinType:'left',
	matchType:'exact',
	ignoreSpaces: false,
	broadcast: 'auto')~> joinMisc
joinMisc, Garage join(derivedColumnAmes@PID == Garage@PID,
	joinType:'left',
	matchType:'exact',
	ignoreSpaces: false,
	broadcast: 'auto')~> joinGarage
joinGarage, Pool join(Ames@pid == Pool@PID,
	joinType:'left',
	matchType:'exact',
	ignoreSpaces: false,
	broadcast: 'auto')~> joinPool
joinPool derive(GrLivArea = toInteger({1st Flr SF}) + toInteger({2nd Flr SF}) + toInteger({Low Qual Fin SF}),
		MoSold = month(toDate({Sale Date})),
		YrSold = year(toDate({Sale Date})),
		{Year Remod/Add} = iif(isNull(toInteger(trim({Year Remod/Add}))) || toInteger(trim({Year Remod/Add})) == 0, toInteger(trim({Year Built})), toInteger(trim({Year Remod/Add}))),
		{Lot Frontage} = coalesce(toInteger(trim({Lot Frontage})), 0),
		{Lot Area} = toInteger(trim({Lot Area})),
		{Overall Qual} = toInteger(trim({Overall Qual})),
		{Overall Cond} = toInteger(trim({Overall Cond})),
		{Year Built} = toInteger(trim({Year Built})),
		{Exter Qual} = cacheTQ#lookup({Exter Qual}).code,
		{Exter Cond} = cacheTQ#lookup({Exter Cond}).code,
		{Heating QC} = cacheTQ#lookup({Heating QC}).code,
		{Kitchen Qual} = cacheTQ#lookup({Kitchen Qual}).code,
		{MS Zoning} = cacheMSZ#lookup({MS Zoning}).code,
		{Central Air} = iif({Central Air}, 'Y', 'N')) ~> transformations
derivedColumnAmes, AmesProperty join(derivedColumnAmes@PID == AmesProperty@PID,
	joinType:'inner',
	matchType:'exact',
	ignoreSpaces: false,
	broadcast: 'auto')~> join1
transformations select(mapColumn(
		PID = Ames@pid,
		MS_sub_class = {MS SubClass},
		MS_zoning = {MS Zoning},
		lot_frontage = {Lot Frontage},
		lot_area = {Lot Area},
		street = Street,
		alley = Alley,
		lot_shape = {Lot Shape},
		land_contour = {Land Contour},
		utilities = Utilities,
		lot_config = {Lot Config},
		land_slope = {Land Slope},
		neighborhood = Neighborhood,
		condition_1 = {Condition 1},
		condition_2 = {Condition 2},
		bldg_type = {Bldg Type},
		house_style = {House Style},
		overall_qual = {Overall Qual},
		overall_cond = {Overall Cond},
		year_built = {Year Built},
		year_remod_add = {Year Remod/Add},
		roof_style = {Roof Style},
		roof_matl = {Roof Matl},
		exterior_1st = {Exterior 1st},
		exterior_2nd = {Exterior 2nd},
		mas_vnr_type = {Mas Vnr Type},
		mas_vnr_area = {Mas Vnr Area},
		exter_qual = {Exter Qual},
		exter_cond = {Exter Cond},
		foundation,
		bsmt_qual = {Bsmt Qual},
		bsmt_cond = {Bsmt Cond},
		bsmt_exposure = {Bsmt Exposure},
		bsmt_fin_type_1 = {BsmtFin Type 1},
		bsmt_fin_sf_1 = {BsmtFin SF 1},
		bsmt_fin_type_2 = {BsmtFin Type 2},
		bsmt_fin_sf_2 = {BsmtFin SF 2},
		bsmt_unf_sf = {Bsmt Unf SF},
		total_bsmt_sf = {Total Bsmt SF},
		heating,
		heating_QC = {Heating QC},
		central_air = {Central Air},
		electrical,
		{1st_flr_sf} = {1st Flr SF},
		{2nd_flr_sf} = {2nd Flr SF},
		low_qual_fin_sf = {Low Qual Fin SF},
		gr_liv_area = GrLivArea,
		bsmt_full_bath = {Bsmt Full Bath},
		bsmt_half_bath = {Bsmt Half Bath},
		full_bath = FullBath,
		half_bath = HalfBath,
		bedroom = Bedroom,
		kitchen_abv_gr = {Kitchen AbvGr},
		kitchen_qual = {Kitchen Qual},
		tot_rms_abv_grd = {TotRms AbvGrd},
		functional,
		fireplaces,
		fireplace_qu = {Fireplace Qu},
		garage_type = {Garage Type},
		garage_yr_blt = {Garage Yr Blt},
		garage_finish = {Garage Finish},
		garage_cars = {Garage Cars},
		garage_area = {Garage Area},
		garage_qual = {Garage Qual},
		garage_cond = {Garage Cond},
		paved_drive = {Paved Drive},
		wood_deck_sf = {Wood Deck SF},
		open_porch_sf = {Open Porch SF},
		enclosed_porch = {Enclosed Porch},
		{3ssn_porch} = {3Ssn Porch},
		screen_porch = {Screen Porch},
		pool_area = {Pool Area},
		pool_QC = {Pool QC},
		fence,
		misc_feature = {Misc Feature},
		misc_val = {Misc Val},
		mo_sold = MoSold,
		yr_sold = YrSold,
		sale_type = {Sale Type},
		sale_condition = {Sale Condition},
		sale_price = saleprice
	),
	skipDuplicateMapInputs: true,
	skipDuplicateMapOutputs: true) ~> select2
select2 derive(each(match(type=='string'), $$ = iif(isNull($$) || trim($$) == '', 'NA', trim($$))),
		each(match(type=='short'||type=='integer'||type=='long'), $$ = coalesce($$, 0))) ~> derivedColumn1
derivedColumn1 sink(allowSchemaDrift: true,
	validateSchema: false,
	skipDuplicateMapInputs: true,
	skipDuplicateMapOutputs: true) ~> sink1
TypeQuality sink(validateSchema: false,
	skipDuplicateMapInputs: true,
	skipDuplicateMapOutputs: true,
	keys:['id'],
	store: 'cache',
	format: 'inline',
	output: false,
	saveOrder: 1) ~> cacheTQ
MSZoning sink(validateSchema: false,
	skipDuplicateMapInputs: true,
	skipDuplicateMapOutputs: true,
	keys:['id'],
	store: 'cache',
	format: 'inline',
	output: false,
	saveOrder: 1) ~> cacheMSZ